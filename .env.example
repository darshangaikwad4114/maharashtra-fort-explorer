# Public site URL used for canonical links, sitemap and Open Graph.
# Local default: http://localhost:3000 — set the HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-safe Supabase credentials. Safe to expose in client bundles.
# Leave both blank to run local-only: favorites stay on the device.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used exclusively by scripts/seed-supabase.ts.
# Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
